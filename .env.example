# Copy to .env and adjust as needed:
#   cp .env.example .env

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tradeshield

# API server
PORT=8080
SESSION_SECRET=dev-secret-change-me
# Public base URL for uploaded KYC files (defaults to request host in dev)
# API_PUBLIC_URL=http://localhost:8080

# Public web app URL used in SMS deep links (no trailing slash)
# APP_PUBLIC_URL=http://localhost:22898

# Frontend (Vite)
WEB_PORT=22898
BASE_PATH=/
API_URL=http://localhost:8080
# Production only: WebSocket base (Vercel rewrites cannot proxy WS)
# VITE_API_WS_URL=wss://tradeshield-i76i.onrender.com

# --- Supabase (production — TradeShield project) ---
# Dashboard: https://supabase.com/dashboard/project/nnfgasglgdavldrjpmlm
# SUPABASE_URL=https://nnfgasglgdavldrjpmlm.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<from Settings → API → service_role>
# KYC_BUCKET_NAME=kyc-documents
PRODUCT_BUCKET_NAME=product-images
# PRODUCT_BUCKET_NAME=product-images
# Create product-images as a public bucket in Supabase Storage so buyer-facing
# product photos load without signed URLs.
# Production DATABASE_URL (Settings → Database → URI, use port 5432):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Payment (optional — omit MOOLRE_API_USER + MOOLRE_ACCOUNT_NUMBER to use mock) ---
# Sandbox example:
# MOOLRE_BASE_URL=https://sandbox.moolre.com
# MOOLRE_API_USER=your-username
# MOOLRE_ACCOUNT_NUMBER=your-wallet-account-number
# MOOLRE_API_KEY=                    # private key (optional in sandbox, required on live)
# MOOLRE_API_PUBKEY=                 # public key (status / payment-link endpoints)
#
# Live:
# MOOLRE_BASE_URL=https://api.moolre.com
# MOOLRE_API_USER=
# MOOLRE_ACCOUNT_NUMBER=
# MOOLRE_API_KEY=
# MOOLRE_API_PUBKEY=
#
# Webhooks (set wallet callback in Moolre dashboard to one of these):
# MOOLRE_COLLECTIONS_CALLBACK_URL=https://yourapp.com/api/webhooks/moolre/collections
# MOOLRE_DISBURSEMENTS_CALLBACK_URL=https://yourapp.com/api/webhooks/moolre/disbursements
# Or unified: https://yourapp.com/api/webhooks/moolre
# MOOLRE_WEBHOOK_SECRET=
#
# SMS (requires approved Sender ID + VAS key):
# MOOLRE_VAS_KEY=
# MOOLRE_SMS_SENDER_ID=TradeShield
#
# Do NOT set a global MoMo channel on Render — channel is chosen per payment
# from the buyer's selected network (payment: MTN=13, Telecel=6, AT=7;
# transfer: MTN=1, Telecel=6, AT=7). A single MOOLRE_DEFAULT_MOMO_CHANNEL
# forces every charge onto one network and breaks the others.
# MOOLRE_DEFAULT_MOMO_CHANNEL=
# Legacy aliases still supported:
# MOOLRE_SANDBOX_USER=   # alias for MOOLRE_API_USER
# MOOLRE_PRIVATE_KEY=    # alias for MOOLRE_API_KEY
# MOOLRE_PUBLIC_KEY=     # alias for MOOLRE_API_PUBKEY
# MOOLRE_API_SECRET=     # legacy alias for MOOLRE_API_PUBKEY

# Mock provider: simulated settlement delay (ms) for local dev polling
# MOCK_PAYMENT_SETTLE_MS=4000

# --- Demo seed users (after pnpm db:seed) — password: demo12345 ---
# +233200000001  supplier
# +233200000002  supplier
# +233200000003  buyer
# +233200000099  both / admin
