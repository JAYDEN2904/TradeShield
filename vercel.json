{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@11.2.2 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.2.2 --filter @workspace/tradeshield run build",
  "outputDirectory": "artifacts/tradeshield/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tradeshield-i76i.onrender.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
